# Neon Postgres connection string (pooled or direct both work)
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 (R2 > Manage API tokens > Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=auto-printer

# Shared password for staff: upload photos, see the queue and printed sheets
APP_PASSWORD=
# Separate password for /admin: settings, print stations, print controls. Use a different one.
ADMIN_PASSWORD=
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
